//@version=6
strategy("Supertrend Strategy + Plots", overlay=true,
     default_qty_type=strategy.percent_of_equity, default_qty_value=100)

// ==== Inputs ====
atrPeriod = input.int(10, "ATR Length")
factor    = input.float(3.0, "Factor", step=0.01)
showSignals = input.bool(true, "Show Buy/Sell Labels")
highlighting = input.bool(true, "Highlight Trend")

// ==== Supertrend ====
[supertrend, direction] = ta.supertrend(factor, atrPeriod)
trend = direction == 1 ? 1 : -1

// ==== Plotting Supertrend ====
up   = supertrend
dn   = supertrend

upPlot = plot(trend == 1 ? up : na, title="Up Trend", style=plot.style_linebr, linewidth=2, color=color.new(color.green, 0))
dnPlot = plot(trend == -1 ? dn : na, title="Down Trend", style=plot.style_linebr, linewidth=2, color=color.new(color.red, 0))
mPlot  = plot(ohlc4, title="", style=plot.style_circles, linewidth=1, color=color.new(color.white, 100))

// Highlight background fill
longFillColor  = highlighting ? (trend == 1 ? color.green : color.white) : color.white
shortFillColor = highlighting ? (trend == -1 ? color.red   : color.white) : color.white
fill(mPlot, upPlot, title="UpTrend Highlighter", color=color.new(longFillColor, 90))
fill(mPlot, dnPlot, title="DownTrend Highlighter", color=color.new(shortFillColor, 90))

// ==== Buy / Sell Signals ====
buySignal  = trend == 1 and trend[1] == -1
sellSignal = trend == -1 and trend[1] == 1

plotshape(buySignal,  title="UpTrend Begins",  location=location.belowbar, style=shape.circle, size=size.tiny, color=color.new(color.green, 0))
plotshape(sellSignal, title="DownTrend Begins", location=location.abovebar, style=shape.circle, size=size.tiny, color=color.new(color.red, 0))

plotshape(buySignal and showSignals,  title="Buy",  text="Buy",  location=location.belowbar, style=shape.labelup,   size=size.tiny, color=color.new(color.green, 0), textcolor=color.white)
plotshape(sellSignal and showSignals, title="Sell", text="Sell", location=location.abovebar, style=shape.labeldown, size=size.tiny, color=color.new(color.red, 0),   textcolor=color.white)

// ==== Strategy Entries ====
if buySignal
    strategy.entry("Long", strategy.long)
if sellSignal
    strategy.entry("Short", strategy.short)
